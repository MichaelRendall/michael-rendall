---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectListItem from '../components/ProjectListItem.astro';
import TitleBar from '../components/TitleBar.astro';
import Window from '../components/Window.astro';
import { featuredProjects, moreProjects } from '../data/projects';
---

<BaseLayout
  page="projects"
  title="Projects, Michael Rendall"
  description="Games, puzzles and experiments built by Michael Rendall."
>
  <Window title="C:\projects" aria-labelledby="proj-title" class="max-w-[724px] shadow-hard-10">
    <div class="flex flex-col gap-3.5 p-[clamp(24px,3vw,36px)]">
      <p class="font-terminal text-[24px] tracking-[2px] text-accent">✦ GAMES, PUZZLES &amp; EXPERIMENTS ✦</p>
      <h1 id="proj-title" class="text-chrome font-pixel text-[clamp(40px,5vw,74px)] leading-[1.08] font-bold">
        Projects
      </h1>
      <p class="max-w-[540px] text-[18px] leading-[1.6] text-ink-soft">
        Things I've built for fun. Each one has a short write-up on how it works and what I'd do differently next time.
      </p>
    </div>
  </Window>

  <section aria-label="Featured projects" class="flex flex-wrap gap-x-8 gap-y-9">
    {featuredProjects.map((project) => (
      <ProjectCard project={project} />
    ))}
  </section>

  <section
    data-anim="intro"
    aria-labelledby="more-title"
    class="max-w-[984px] border-2 border-ink bg-paper shadow-hard-8 shadow-pink"
  >
    <TitleBar size="md" reverse>
      <h2 id="more-title" class="font-terminal text-[21px] font-normal tracking-[1px]">
        more_projects.dir
      </h2>
      <span slot="end" class="font-terminal text-[19px]">
        {moreProjects.length} items
      </span>
    </TitleBar>
    <ul>
      {moreProjects.map((project, index) => (
        <ProjectListItem project={project} index={index} />
      ))}
    </ul>
  </section>
</BaseLayout>
