---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Quiz from '../../components/quiz/Quiz.astro';
import { shapeUrls } from '../../data/shape-urls';
import { shapesQuiz } from '../../scripts/quiz/shapes';
---

<BaseLayout page="quizzes" title="Shapes, Michael Rendall" description="Name the country from its outline.">
  <Quiz quiz={shapesQuiz} images={shapeUrls} heading="Shapes" windowTitle="shapes.exe" shadow="teal" />
</BaseLayout>

<script>
  import { initQuiz } from '../../scripts/quiz/engine';
  import { shapesQuiz } from '../../scripts/quiz/shapes';

  const root = document.querySelector<HTMLElement>('[data-quiz]');
  if (root) initQuiz(root, shapesQuiz);
</script>
