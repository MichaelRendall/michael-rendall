---
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuizCard from '../../components/QuizCard.astro';
import Window from '../../components/Window.astro';
import { quizzes } from '../../data/quizzes';
---

<BaseLayout page="quizzes" title="Quizzes, Michael Rendall" description="Quick quizzes to test what you know.">
  <div class="mx-auto flex w-full max-w-232 flex-col gap-9">
    <Window title="C:\quizzes" aria-labelledby="quizzes-title" class="shadow-hard-10">
      <div class="flex flex-col gap-3.5 p-[clamp(1.5rem,3vw,2.25rem)]">
        <h1 id="quizzes-title" class="text-chrome font-pixel text-display leading-[1.08] font-bold">
          Quizzes
        </h1>
        <p class="text-body-lg leading-[1.6] text-ink-soft">Quick quizzes to test what you know. Pick one and play.</p>
      </div>
    </Window>

    <section aria-label="All quizzes" class="grid gap-8 sm:grid-cols-2">
      {quizzes.map((quiz) => (
        <QuizCard quiz={quiz} />
      ))}
    </section>
  </div>
</BaseLayout>
