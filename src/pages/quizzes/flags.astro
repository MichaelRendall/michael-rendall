---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import TitleBar from '../../components/TitleBar.astro';
import Window from '../../components/Window.astro';
import { continents, countries } from '../../data/countries';
import { DEFAULT_SETTINGS, LENGTHS } from '../../scripts/flags/settings';

// Flag SVGs from the flag-icons package, emitted as hashed files. Only the quiz countries' URLs reach the page.
const flagFiles = import.meta.glob<string>('/node_modules/flag-icons/flags/4x3/*.svg', {
  query: '?url',
  import: 'default',
  eager: true,
});
const flags = Object.fromEntries(
  countries.map(({ code }) => {
    const url = flagFiles[`/node_modules/flag-icons/flags/4x3/${code}.svg`];
    if (!url) throw new Error(`No flag file for "${code}"`);
    return [code, url];
  }),
);

const label = 'font-terminal text-label tracking-label';
const countIn = (continent: string): number => countries.filter((c) => c.continent === continent).length;

// Settings chips: a visually hidden radio or checkbox inside a clickable label. The tick marks the
// selected chips without relying on colour alone.
const chip = [
  'group inline-flex min-h-10 cursor-pointer items-center gap-1.5 border-2 border-ink bg-paper px-3',
  'font-terminal text-label tracking-label text-ink hover:bg-mint-mist',
  'has-checked:bg-mint-light has-checked:shadow-hard-3 has-checked:shadow-pink',
  'has-focus-visible:outline-3 has-focus-visible:outline-offset-3 has-focus-visible:outline-violet',
];
const tick = 'hidden group-has-checked:inline';
const textButton = [
  'cursor-pointer font-terminal text-label-sm tracking-label underline underline-offset-4 hover:text-accent',
  'focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-violet',
  'disabled:cursor-default disabled:no-underline disabled:opacity-50',
];
---

<BaseLayout page="quizzes" title="Flags, Michael Rendall" description="Name the country from its flag.">
  <Window as="main" title="flags.exe" aria-labelledby="quiz-title" class="mx-auto w-full max-w-136 shadow-hard-8">
    <div data-quiz data-flags={JSON.stringify(flags)} class="flex flex-col gap-4 p-[clamp(1.25rem,2.5vw,1.75rem)]">
      <h1
        id="quiz-title"
        class="text-chrome font-pixel text-[clamp(1.75rem,1.25rem+1.5vw,2.5rem)] leading-[1.08] font-bold"
      >
        Flags
      </h1>

      <section data-screen="start" class="flex flex-col items-start gap-3">
        <p class="text-body leading-[1.6] text-ink-soft">
          Name the country for each flag. Type the right name and it's accepted straight away. Stuck? Move on with Next
          and come back later. The quiz ends when you've named them all, or when you give up.
        </p>
        <p data-summary class={label}>
          {DEFAULT_SETTINGS.length} flags from all continents
        </p>
        <p data-best hidden class={label}></p>
        <div class="flex flex-wrap gap-2.5">
          <Button data-start icon="play">
            Start quiz
          </Button>
          <Button data-open-settings variant="secondary" icon="sliders">
            Settings
          </Button>
        </div>
        <noscript>
          <p class="text-body">The quiz needs JavaScript to run.</p>
        </noscript>
      </section>

      <section data-screen="play" hidden class="flex flex-col gap-3">
        <div class:list={['flex justify-between gap-4', label]}>
          <span>
            Flag <span data-round>1</span> of <span data-total>{DEFAULT_SETTINGS.length}</span>
          </span>
          <span>
            Score <span data-score>0</span>
          </span>
        </div>
        <img
          data-flag
          alt="The flag to identify"
          width="640"
          height="480"
          class="mx-auto aspect-4/3 w-full max-w-72 border-2 border-ink bg-paper object-cover shadow-hard-4 shadow-lilac"
        />
        <div class="flex flex-col gap-2">
          <label for="guess" class={label}>
            Which country is this?
          </label>
          <input
            id="guess"
            data-guess
            type="text"
            autocomplete="off"
            autocapitalize="words"
            spellcheck="false"
            class="min-h-12 w-full border-2 border-ink bg-white px-3 text-body text-ink focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-violet disabled:bg-blush read-only:bg-blush"
          />
          <div class="mt-1 flex flex-wrap justify-between gap-2.5">
            <div class="flex gap-2.5">
              <Button data-prev variant="secondary">
                <span aria-hidden="true">←</span> Previous
              </Button>
              <Button data-next variant="secondary">
                Next <span aria-hidden="true">→</span>
              </Button>
            </div>
            <Button data-give-up>Give up</Button>
          </div>
        </div>
        <p data-feedback role="status" class="min-h-[1.5em] text-body font-semibold"></p>
      </section>

      <section data-screen="results" hidden class="flex flex-col items-start gap-3">
        <h2 data-result-title tabindex="-1" class="font-pixel text-label-xl font-bold focus:outline-none">
          Results
        </h2>
        <p data-result-best class={label}></p>
        <div data-missed-wrap class="flex w-full flex-col gap-2">
          <h3 class={label}>Flags you didn't get</h3>
          <ul data-missed class="grid gap-2 sm:grid-cols-2"></ul>
        </div>
        <div class="flex flex-wrap gap-2.5">
          <Button data-again icon="play">
            Play again
          </Button>
          <Button data-open-settings variant="secondary" icon="sliders">
            Settings
          </Button>
        </div>
      </section>

      <dialog
        data-settings-dialog
        aria-labelledby="settings-title"
        class="m-auto max-h-[calc(100dvh-2rem)] w-[min(34rem,calc(100%-2rem))] border-2 border-ink bg-paper text-ink shadow-hard-8 backdrop:bg-ink/40"
      >
        <TitleBar size="md">
          <h2 id="settings-title" class="font-terminal text-label-lg font-normal tracking-label">
            settings.ini
          </h2>
          <button
            slot="end"
            type="button"
            data-settings-close
            aria-label="Close settings"
            class="grid size-7 cursor-pointer place-items-center border-2 border-ink bg-paper font-terminal text-label-lg leading-none hover:bg-pink-light focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-violet"
          >
            ×
          </button>
        </TitleBar>
        <form data-settings method="dialog" class="flex flex-col items-start gap-5 p-[clamp(1.25rem,2.5vw,1.75rem)]">
          <fieldset class="flex flex-col gap-1.5">
            <legend class:list={[label, 'mb-1.5']}>Flags per game</legend>
            <div class="flex flex-wrap gap-2">
              {LENGTHS.map((length) => (
                <label class:list={chip}>
                  <input
                    type="radio"
                    name="length"
                    value={String(length)}
                    checked={length === DEFAULT_SETTINGS.length}
                    class="sr-only"
                  />
                  <span aria-hidden="true" class={tick}>
                    ✓
                  </span>
                  {length === 'all' ? 'All' : length}
                </label>
              ))}
            </div>
          </fieldset>
          <fieldset class="flex flex-col gap-1.5">
            <legend class:list={[label, 'mb-1.5']}>Continents</legend>
            <div class="flex flex-wrap gap-2">
              {continents.map((continent) => (
                <label class:list={chip}>
                  <input type="checkbox" name="continent" value={continent} checked class="sr-only" />
                  <span aria-hidden="true" class={tick}>
                    ✓
                  </span>
                  {continent}
                  <span class="text-ink-soft">({countIn(continent)})</span>
                </label>
              ))}
            </div>
            <div class="mt-1 flex gap-4">
              <button type="button" data-select-all class:list={textButton}>
                Select all
              </button>
              <button type="button" data-clear class:list={textButton}>
                Clear
              </button>
            </div>
          </fieldset>
          <p data-summary aria-live="polite" class={label}>
            {DEFAULT_SETTINGS.length} flags from all continents
          </p>
          <Button type="submit">Done</Button>
        </form>
      </dialog>
    </div>
  </Window>
</BaseLayout>

<script>
  import { initQuiz } from '../../scripts/flags/quiz';

  const root = document.querySelector<HTMLElement>('[data-quiz]');
  if (root) initQuiz(root);
</script>
