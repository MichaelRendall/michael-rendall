---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Quiz from '../../components/quiz/Quiz.astro';
import { flagsQuiz } from '../../scripts/quiz/flags';
---

<BaseLayout page="quizzes" title="Flags, Michael Rendall" description="Name the country from its flag.">
  <Quiz quiz={flagsQuiz} heading="Flags" windowTitle="flags.exe" />
</BaseLayout>

<script>
  import { initQuiz } from '../../scripts/quiz/engine';
  import { flagsQuiz } from '../../scripts/quiz/flags';

  const root = document.querySelector<HTMLElement>('[data-quiz]');
  if (root) initQuiz(root, flagsQuiz);
</script>
