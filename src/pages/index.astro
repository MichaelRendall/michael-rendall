---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Window from '../components/Window.astro';
---

<BaseLayout
  page="home"
  title="Michael Rendall, frontend developer"
  description="Michael Rendall is a frontend developer based in Glasgow."
>
  <Window
    as="main"
    id="top"
    title="about_me.exe"
    class="w-full max-w-[604px] shadow-[10px_10px_0_var(--color-mint),10px_10px_0_2px_var(--color-ink)]"
  >
    <div class="flex flex-col gap-4 p-[clamp(26px,3vw,40px)]">
      <p data-anim="intro" class="font-terminal text-[24px] tracking-[2px] text-accent">
        ✦ FRONTEND DEVELOPER ✦
      </p>
      <h1 data-anim="intro" class="text-chrome font-pixel text-[clamp(40px,5vw,74px)] leading-[1.08] font-bold">
        Michael Rendall
      </h1>
      <p data-anim="intro" class="max-w-[480px] text-[clamp(17px,1.4vw,19px)] leading-[1.6] text-ink-soft">
        Mid-level frontend developer building [WHAT YOU BUILD]. I care about fast, accessible interfaces and the small
        details that make them feel good.
      </p>
      <nav data-anim="intro" aria-label="Contact" class="mt-2 flex flex-wrap gap-3">
        <Button href="mailto:hello@example.com" size="lg" icon="mail">
          Email me
        </Button>
        <Button href="https://github.com/" size="lg" icon="code">
          GitHub
        </Button>
        <Button href="https://www.linkedin.com/" size="lg" icon="briefcase">
          LinkedIn
        </Button>
      </nav>
    </div>
  </Window>
</BaseLayout>
