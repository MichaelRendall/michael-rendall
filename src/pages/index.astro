---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Window from '../components/Window.astro';
---

<BaseLayout page="home" title="Michael Rendall" description="Games, quizzes, and tools Michael Rendall builds for fun.">
  <Window
    as="main"
    id="main"
    title="about_me.exe"
    class="w-full max-w-151 shadow-[10px_10px_0_var(--color-mint),10px_10px_0_2px_var(--color-ink)]"
  >
    <div class="flex flex-col gap-4 p-[clamp(1.625rem,3vw,2.5rem)] short:gap-3 short:p-7">
      <h1
        data-anim="intro"
        class="text-chrome font-pixel text-display leading-[1.08] font-bold short:text-display-short"
      >
        Michael Rendall
      </h1>
      <p data-anim="intro" class="max-w-120 text-body-lg leading-[1.6] text-ink-soft">
        Games, quizzes, and tools I build for fun.
      </p>
      <nav data-anim="intro" aria-label="Contact" class="mt-2 flex flex-wrap gap-3 short:mt-1">
        <Button href="mailto:michaelrendallmail@gmail.com" size="lg" icon="mail">
          Email me
        </Button>
        <Button href="https://github.com/MichaelRendall" size="lg" icon="code" newTab>
          GitHub
        </Button>
        <Button href="https://www.linkedin.com/in/michael-rendall/" size="lg" icon="briefcase" newTab>
          LinkedIn
        </Button>
      </nav>
    </div>
  </Window>
</BaseLayout>
