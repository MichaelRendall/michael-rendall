---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HubCard from '../../components/HubCard.astro';
import Window from '../../components/Window.astro';
import { games } from '../../data/games';
---

<BaseLayout page="games" title="Games, Michael Rendall" description="Games to play with friends.">
  <main id="main" class="mx-auto flex w-full max-w-232 flex-col gap-9">
    <Window title="C:\games" aria-labelledby="games-title" class="shadow-hard-10 shadow-teal">
      <div class="flex flex-col gap-3.5 p-[clamp(1.5rem,3vw,2.25rem)]">
        <h1 id="games-title" class="text-chrome font-pixel text-display leading-[1.08] font-bold">
          Games
        </h1>
        <p class="text-body-lg leading-[1.6] text-ink-soft">Games to play with friends. Pick one and play.</p>
      </div>
    </Window>

    <section aria-label="All games" class="grid gap-8 sm:grid-cols-2">
      {games.map((game) => (
        <HubCard card={game} />
      ))}
    </section>
  </main>
</BaseLayout>
