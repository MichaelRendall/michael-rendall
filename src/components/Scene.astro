---
// The beach scene. Inline SVG so GSAP can animate its parts (see src/scripts/main.ts).
// Layers are tagged with data-vw-layer for parallax; class names are animation hooks.
---
<svg viewBox="0 0 1440 900" preserveAspectRatio="xMaxYMid slice" style="position: absolute; inset: 0; width: 100%; height: 100%; display: block">
<defs>
<linearGradient id="vwSky" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#6fd0e8"></stop><stop offset="0.4" stop-color="#a9d8f0"></stop><stop offset="0.75" stop-color="#f1b9e0"></stop><stop offset="1" stop-color="#ffd6ea"></stop></linearGradient>
<radialGradient id="vwGlow" cx="0.5" cy="1" r="0.7"><stop offset="0" stop-color="#ffe6f2" stop-opacity="0.95"></stop><stop offset="1" stop-color="#ffe6f2" stop-opacity="0"></stop></radialGradient>
<radialGradient id="vwMoon" cx="0.35" cy="0.32" r="0.75"><stop offset="0" stop-color="#fff7fb"></stop><stop offset="0.45" stop-color="#ffe1ef"></stop><stop offset="0.8" stop-color="#f6b2d8"></stop><stop offset="1" stop-color="#c2a8f2"></stop></radialGradient>
<radialGradient id="vwMoonHalo" cx="0.5" cy="0.5" r="0.5"><stop offset="0.55" stop-color="#fff2f9" stop-opacity="0.7"></stop><stop offset="1" stop-color="#fff2f9" stop-opacity="0"></stop></radialGradient>
<linearGradient id="vwMtn" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#b9a4ee"></stop><stop offset="1" stop-color="#e6d6fa"></stop></linearGradient>
<linearGradient id="vwSea" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#b8eef2"></stop><stop offset="0.35" stop-color="#7fdde8"></stop><stop offset="0.75" stop-color="#7cc9ec"></stop><stop offset="1" stop-color="#c7a8f0"></stop></linearGradient>
<linearGradient id="vwSand" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fff1f6"></stop><stop offset="0.5" stop-color="#ffd9ea"></stop><stop offset="1" stop-color="#f3b4dc"></stop></linearGradient>
<linearGradient id="vwScreen" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#b6fff6"></stop><stop offset="1" stop-color="#4fd8d0"></stop></linearGradient>
<linearGradient id="vwBldg" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#e9dcfb"></stop><stop offset="1" stop-color="#cbb6f2"></stop></linearGradient>
<linearGradient id="vwBldg2" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#f9d9ee"></stop><stop offset="1" stop-color="#e7b3dc"></stop></linearGradient>
{/* One puffy outline, drawn twice: a soft pink copy slightly lower for shading, then the white cloud on top.
    The underside is small overlapping puffs rather than a flat base, so it reads as cloud, not saucer. */}
<g id="vwCloudShape">
<circle cx="-98" cy="6" r="30"></circle><circle cx="-55" cy="-18" r="44"></circle><circle cx="6" cy="-34" r="56"></circle><circle cx="64" cy="-14" r="42"></circle><circle cx="106" cy="8" r="26"></circle>
