---
// The year is rendered at build time and kept current by src/scripts/main.ts.
interface Props {
  /** Pushes the footer to the bottom of a flex column. */
  pinBottom?: boolean;
}

const { pinBottom = false } = Astro.props;
// Plain information, so no border or offset shadow: those are reserved for things you can click.
// The translucent backing keeps the text readable over the scene.
const chip = 'bg-paper/75 px-3 py-1 font-terminal text-label tracking-label';
---

<footer data-anim="intro" class:list={['flex justify-end', pinBottom && 'mt-auto']}>
  <span class={chip}>
    © <span data-year>{new Date().getFullYear()}</span> Michael Rendall
  </span>
</footer>
