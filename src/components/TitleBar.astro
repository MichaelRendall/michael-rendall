---
// The gradient title bar across the top of a retro window.
interface Props {
  size?: 'sm' | 'md' | 'lg';
  /** Number of window-control squares on the right. 0 hides them. */
  controls?: 2 | 3 | 0;
  /** Runs the gradient mint to pink instead of pink to mint. */
  reverse?: boolean;
}

const { size = 'lg', controls = 3, reverse = false } = Astro.props;

const heights = { sm: 'h-9 px-2.5', md: 'h-9.5 px-3', lg: 'h-10 px-3' };
const fills = controls === 2 ? ['bg-paper', 'bg-pink'] : ['bg-paper', 'bg-paper', 'bg-pink'];
---

<div
  class:list={[
    'flex items-center justify-between gap-3 border-b-2 border-ink bg-linear-90/srgb via-lilac',
    reverse ? 'from-sky to-pink' : 'from-pink to-sky',
    heights[size],
  ]}
>
  <slot />
  <slot name="end">
    {controls > 0 && (
      <span aria-hidden="true" class:list={['flex', size === 'sm' ? 'gap-1.25' : 'gap-1.5']}>
        {fills.map((fill) => (
          <span class:list={['border-2 border-ink', size === 'sm' ? 'size-3' : 'size-3.5', fill]} />
        ))}
      </span>
    )}
  </slot>
</div>
