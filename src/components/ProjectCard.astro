---
import type { FeaturedProject } from '../data/projects';
import Button from './Button.astro';
import Icon from './Icon.astro';
import TitleBar from './TitleBar.astro';

interface Props {
  project: FeaturedProject;
}

const { project } = Astro.props;
const shadows = { mint: '', pink: 'shadow-pink', lilac: 'shadow-lilac' };
const tagColours = ['bg-lilac-mist', 'bg-mint-mist', 'bg-pink-mist'];
const [from, to] = project.previewColours;
---

<article
  data-anim="intro"
  class:list={[
    'flex max-w-[444px] flex-[1_1_344px] flex-col border-2 border-ink bg-paper shadow-hard-8',
    shadows[project.shadow],
  ]}
>
  <TitleBar size="sm" controls={2}>
    <span class="font-terminal text-[20px]">{project.file}</span>
  </TitleBar>
  <div
    class="flex h-[202px] flex-col items-center justify-center gap-2.5 border-b-2 border-ink bg-linear-135/srgb from-(--from) to-(--to)"
    style={{ '--from': from, '--to': to }}
  >
    <Icon name={project.icon} size={56} strokeWidth={1.6} />
    <span class="font-terminal text-[20px] tracking-[1px]">[SCREENSHOT OR GIF]</span>
  </div>
  <div class="flex grow flex-col gap-3 p-[22px]">
    <h2 class="font-pixel text-[26px] leading-[1.15] font-bold">{project.name}</h2>
    <p class="text-[16px] leading-[1.55] text-ink-soft">{project.summary}</p>
    <div class="flex flex-wrap gap-2">
      {project.tags.map((tag, i) => (
        <span
          class:list={[
            'border-2 border-ink px-2.5 py-0.5 font-terminal text-[18px]',
            tagColours[i % tagColours.length],
          ]}
        >
          {tag}
        </span>
      ))}
    </div>
    <div class="mt-auto flex flex-wrap gap-3 pt-1.5">
      <Button href={project.demoUrl} icon="play">
        Play demo<span class="sr-only">: {project.name}</span>
      </Button>
      <Button href={project.codeUrl} variant="secondary" icon="code">
        View code<span class="sr-only">: {project.name}</span>
      </Button>
    </div>
  </div>
</article>
