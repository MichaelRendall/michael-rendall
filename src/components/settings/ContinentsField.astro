---
// The continent filter every game shares, with Select all and Clear.
import ChipGroup from './ChipGroup.astro';
import TextButton from '../TextButton.astro';
import { continents, countries as allCountries, type Country } from '../../data/countries';

interface Props {
  /** The game's countries, if not all of them, so each continent's count matches what can come up. */
  countries?: readonly Country[];
}

const { countries = allCountries } = Astro.props;
const options = continents.map((continent) => ({
  value: continent,
  label: continent,
  note: String(countries.filter((c) => c.continent === continent).length),
}));
---

<ChipGroup legend="Continents" name="continent" type="checkbox" options={options} checked={[...continents]}>
  <div class="mt-1 flex gap-4">
    <TextButton data-select-all>Select all</TextButton>
    <TextButton data-clear>Clear</TextButton>
  </div>
</ChipGroup>
