---
import Scene from './Scene.astro';

interface Props {
  /** Fixed behind scrolling content, so the scene stays put while the page scrolls. */
  fixed?: boolean;
}

const { fixed = false } = Astro.props;
---

<div aria-hidden="true" class:list={['pointer-events-none inset-0', fixed ? 'fixed' : 'absolute']}>
  <Scene />
  <svg width="100%" height="100%" class="absolute inset-0 opacity-14 mix-blend-multiply">
    <filter id="vwGrain">
      <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" stitchTiles="stitch"></feTurbulence>
      <feColorMatrix type="saturate" values="0"></feColorMatrix>
    </filter>
    <rect width="100%" height="100%" filter="url(#vwGrain)"></rect>
  </svg>
  <div class="absolute inset-0 bg-scanlines"></div>
</div>
