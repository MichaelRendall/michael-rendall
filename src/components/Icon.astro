---
// Line icons on a 24x24 grid. Each icon keeps its own line caps and joins.
interface IconDef {
  cap?: 'square' | 'round';
  join?: 'miter' | 'round';
  body: string;
}

const icons = {
  home: {
    cap: 'square',
    join: 'miter',
    body: '<path d="M3 11 12 4l9 7"></path><path d="M5 10v10h14V10"></path><path d="M10 20v-6h4v6"></path>',
  },
  mail: {
    cap: 'round',
    join: 'round',
    body: '<rect x="3" y="5" width="18" height="14" rx="1"></rect><path d="m3 7 9 6 9-6"></path>',
  },
  code: { cap: 'round', join: 'round', body: '<path d="m8 7-5 5 5 5"></path><path d="m16 7 5 5-5 5"></path>' },
  briefcase: {
    cap: 'round',
    join: 'round',
    body: '<rect x="3" y="7" width="18" height="13" rx="1"></rect><path d="M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"></path>',
  },
  play: { cap: 'square', body: '<path d="M7 4v16l13-8z"></path>' },
  puzzle: { join: 'round', body: '<path d="M4 8h4a2 2 0 1 1 4 0h4v4a2 2 0 1 1 0 4v4H4v-4a2 2 0 1 0 0-4z"></path>' },
  flag: { cap: 'square', join: 'miter', body: '<path d="M5 21V4"></path><path d="M5 4h13l-3 4.5 3 4.5H5"></path>' },
  pin: {
    join: 'round',
    body: '<path d="M12 21s-7-6.5-7-12a7 7 0 0 1 14 0c0 5.5-7 12-7 12z"></path><circle cx="12" cy="9" r="2.5"></circle>',
  },
  calendar: {
    cap: 'square',
    join: 'miter',
    body: '<rect x="3" y="5" width="18" height="16"></rect><path d="M3 10h18M8 3v4M16 3v4"></path>',
  },
  eye: {
    cap: 'round',
    join: 'round',
    body: '<path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12z"></path><circle cx="12" cy="12" r="3"></circle>',
  },
  gamepad: {
    cap: 'square',
    body: '<rect x="2" y="7" width="20" height="11" rx="2"></rect><path d="M7 10v5M4.5 12.5h5"></path><circle cx="16" cy="11" r="1"></circle><circle cx="18.5" cy="13.5" r="1"></circle>',
  },
  shape: {
    join: 'round',
    body: '<path d="M5 6l5-2 3 3 5-1 2 5-3 3 1 5-5 1-3-3-5 2-2-6 3-3z"></path>',
  },
  updown: {
    cap: 'square',
    join: 'miter',
    body: '<path d="M8 20V4M4 8l4-4 4 4"></path><path d="M16 4v16M12 16l4 4 4-4"></path>',
  },
  sliders: {
    cap: 'square',
    body: '<path d="M4 6h9M19 6h1M4 12h3M13 12h7M4 18h11M21 18h-1"></path><rect x="13" y="4" width="4" height="4"></rect><rect x="7" y="10" width="4" height="4"></rect><rect x="15" y="16" width="4" height="4"></rect>',
  },
} satisfies Record<string, IconDef>;

export type IconName = keyof typeof icons;

// Sizes in rem, so icons scale with the visitor's browser font size.
const sizes = {
  sm: 'size-4', // 16px at default font size
  md: 'size-4.5', // 18px
  lg: 'size-5.5', // 22px
  xl: 'size-14', // 56px
};

interface Props {
  name: IconName;
  size?: keyof typeof sizes;
  strokeWidth?: number;
}

const { name, size = 'md', strokeWidth = 2 } = Astro.props;
const icon: IconDef = icons[name];
---

<svg
  class={sizes[size]}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap={icon.cap}
  stroke-linejoin={icon.join}
  aria-hidden="true"
  set:html={icon.body}
/>
