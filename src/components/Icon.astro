---
// Line icons on a 24x24 grid. Each icon keeps its own line caps and joins.
interface IconDef {
  cap?: 'square' | 'round';
  join?: 'miter' | 'round';
  body: string;
}

const icons = {
  home: {
    cap: 'square',
    join: 'miter',
    body: '<path d="M3 11 12 4l9 7"></path><path d="M5 10v10h14V10"></path><path d="M10 20v-6h4v6"></path>',
  },
  folder: { cap: 'square', join: 'miter', body: '<path d="M3 6h7l2 2h9v11H3z"></path>' },
  mail: {
    cap: 'round',
    join: 'round',
    body: '<rect x="3" y="5" width="18" height="14" rx="1"></rect><path d="m3 7 9 6 9-6"></path>',
  },
  code: { cap: 'round', join: 'round', body: '<path d="m8 7-5 5 5 5"></path><path d="m16 7 5 5-5 5"></path>' },
  briefcase: {
    cap: 'round',
    join: 'round',
    body: '<rect x="3" y="7" width="18" height="13" rx="1"></rect><path d="M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"></path>',
  },
  play: { cap: 'square', body: '<path d="M7 4v16l13-8z"></path>' },
  file: { cap: 'square', body: '<path d="M5 3h10l4 4v14H5z"></path><path d="M14 3v5h5"></path>' },
  gamepad: {
    cap: 'square',
    body: '<rect x="2" y="7" width="20" height="11" rx="2"></rect><path d="M7 10v5M4.5 12.5h5"></path><circle cx="16" cy="11" r="1"></circle><circle cx="18.5" cy="13.5" r="1"></circle>',
  },
  puzzle: { join: 'round', body: '<path d="M4 8h4a2 2 0 1 1 4 0h4v4a2 2 0 1 1 0 4v4H4v-4a2 2 0 1 0 0-4z"></path>' },
  grid: {
    cap: 'square',
    body: '<rect x="3" y="3" width="18" height="18"></rect><path d="M9 3v18M15 3v18M3 9h18M3 15h18"></path>',
  },
} satisfies Record<string, IconDef>;

export type IconName = keyof typeof icons;

// Sizes in rem, so icons scale with the visitor's browser font size.
const sizes = {
  sm: 'size-4', // 16px at default font size
  md: 'size-4.5', // 18px
  lg: 'size-5.5', // 22px
  xl: 'size-14', // 56px
};

interface Props {
  name: IconName;
  size?: keyof typeof sizes;
  strokeWidth?: number;
}

const { name, size = 'md', strokeWidth = 2 } = Astro.props;
const icon: IconDef = icons[name];
---

<svg
  class={sizes[size]}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap={icon.cap}
  stroke-linejoin={icon.join}
  aria-hidden="true"
  set:html={icon.body}
/>
