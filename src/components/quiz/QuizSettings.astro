---
// The quizzes' settings: answer mode (when a quiz has more than one), game length and continents.
// src/scripts/quiz/engine.ts reads and saves them.
import ChipGroup from '../settings/ChipGroup.astro';
import ContinentsField from '../settings/ContinentsField.astro';
import SettingsDialog from '../settings/SettingsDialog.astro';
import type { Country } from '../../data/countries';
import { MODE_LABELS, type Mode } from '../../scripts/quiz/definition';
import { LENGTHS, defaultSettings } from '../../scripts/quiz/settings';

interface Props {
  /** Plural noun, e.g. "flags" for "Flags per game". */
  unit: string;
  /** The quiz's modes. With more than one, the player picks how to answer. */
  modes: readonly Mode[];
  /** The quiz's countries, if not all of them, so the continent counts match. */
  countries?: readonly Country[];
  /** The summary tags for the default settings. */
  summary: string[];
}

const { unit, modes, summary, countries } = Astro.props;
const defaults = defaultSettings(modes);
const unitTitle = unit.charAt(0).toUpperCase() + unit.slice(1);
---

<SettingsDialog summary={summary}>
  {modes.length > 1 && (
    <ChipGroup
      legend="Answer by"
      name="mode"
      type="radio"
      options={modes.map((mode) => ({ value: mode, label: MODE_LABELS[mode] }))}
      checked={[defaults.mode]}
    />
  )}
  <ChipGroup
    legend={`${unitTitle} per game`}
    name="length"
    type="radio"
    options={LENGTHS.map((length) => ({ value: String(length), label: length === 'all' ? 'All' : String(length) }))}
    checked={[String(defaults.length)]}
  />
  <ContinentsField countries={countries} />
</SettingsDialog>
