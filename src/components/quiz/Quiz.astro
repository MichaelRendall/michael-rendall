---
// The window, screens and controls shared by every quiz. The page passes its QuizDefinition
// and runs src/scripts/quiz/engine.ts with the same definition.
import Button from '../Button.astro';
import TextButton from '../TextButton.astro';
import Window from '../Window.astro';
import QuizSettings from './QuizSettings.astro';
import SummaryTags from '../settings/SummaryTags.astro';
import { BEST_TAG_CLASS } from '../../scripts/settings-dialog';
import { flagUrls } from '../../data/flag-urls';
import { MODE_LABELS, type QuizDefinition } from '../../scripts/quiz/definition';
import { defaultSettings } from '../../scripts/quiz/settings';

interface Props {
  quiz: QuizDefinition;
  /** The page heading, e.g. "Flags". */
  heading: string;
  /** Pictures to ask about instead of flags (country code to URL), e.g. the shapes quiz's outlines. */
  images?: Record<string, string>;
  /** The window's title bar, e.g. "flags.exe". */
  windowTitle: string;
}

const { quiz, heading, windowTitle, images } = Astro.props;
const defaults = defaultSettings(quiz.modes);
// Rendered at build time, matching what the engine shows for the default settings.
const summary = [
  `${defaults.length} ${quiz.unit}`,
  'All continents',
  ...(quiz.modes.length > 1 ? [MODE_LABELS[defaults.mode]] : []),
];

const label = 'font-terminal text-label tracking-label';
---

<Window
  as="main"
  id="main"
  title={windowTitle}
  aria-labelledby="quiz-title"
  class="mx-auto w-full max-w-136 shadow-hard-8"
>
  <div
    data-quiz
    data-flags={JSON.stringify(flagUrls)}
    data-images={images ? JSON.stringify(images) : undefined}
    class="flex flex-col gap-4 p-[clamp(1.25rem,2.5vw,1.75rem)]"
  >
    <h1
      id="quiz-title"
      class="text-chrome font-pixel text-[clamp(1.75rem,1.25rem+1.5vw,2.5rem)] leading-[1.08] font-bold"
    >
      {heading}
    </h1>

    <section data-screen="start" class="flex flex-col items-start gap-3">
      <p data-intro class="text-body leading-[1.6] text-ink-soft">
        {quiz.intro[defaults.mode]}
      </p>
      <SummaryTags parts={summary} />
      <p data-best hidden class={BEST_TAG_CLASS}></p>
      <div class="flex flex-wrap gap-2.5">
        <Button data-start icon="play">
          Start quiz
        </Button>
        <Button data-open-settings variant="secondary" icon="sliders">
          Settings
        </Button>
      </div>
      <noscript>
        <p class="text-body">The quiz needs JavaScript to run.</p>
      </noscript>
    </section>

    <section data-screen="play" hidden class="flex flex-col gap-3">
      {/* Give up sits with the game status, away from the answer controls, so it's hard to hit by mistake. */}
      {/*
        Reads "1 / 46 | Score 0". Screen readers hear "Question 1 of 46, Score 0" from the hidden words.
        Give up uses the same text size, so centring the row lines the two up exactly.
        Spaces are written as {' '} because Astro drops line breaks next to elements.
      */}
      <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1">
        <p class:list={[label, 'whitespace-nowrap']}>
          <span class="sr-only">{quiz.progressLabel} </span>
          <span data-round>1</span>
          <span aria-hidden="true">{' / '}</span>
          <span class="sr-only">{' of '}</span>
          <span data-total>{defaults.length}</span>
          <span aria-hidden="true" class="mx-[0.6em] text-ink-soft/50">
            |
          </span>
          <span class="sr-only">{', '}</span>
          Score <span data-score>0</span>
        </p>
        <TextButton data-give-up size="md">
          Give up
        </TextButton>
      </div>
      {/* Smaller on phones so the answers fit below it. A fixed size, not one tied to screen height, so it
        doesn't change when the on-screen keyboard opens. */}
      <img
        data-picture
        alt=""
        width="640"
        height="480"
        class="mx-auto aspect-4/3 w-full max-w-72 border-2 max-sm:max-w-48 border-ink bg-paper object-cover shadow-hard-4 shadow-lilac"
      />
      <p id="quiz-question" data-question class="text-body-lg font-semibold"></p>
      {/* Screen readers only: says which question is next when the quiz moves on by itself. */}
      <p data-announce aria-live="polite" class="sr-only"></p>

      {/* Type mode: a text box. Choice mode: four option buttons. The engine shows the one the quiz uses. */}
      <input
        data-guess
        hidden
        type="text"
        aria-labelledby="quiz-question"
        name="country-guess"
        autocomplete="off"
        autocorrect="off"
        autocapitalize="words"
        spellcheck="false"
        enterkeyhint="done"
        data-1p-ignore
        data-lpignore="true"
        data-bwignore
        data-form-type="other"
        class="min-h-12 w-full border-2 border-ink bg-white px-3 text-body text-ink focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-violet disabled:bg-blush read-only:bg-blush"
      />
      {/* tabindex="-1": the engine focuses the group, not the first option, so no option shows a focus ring
        until the player presses Tab. Focus in the group is what turns on the 1 to 4 keys. */}
      <div
        data-choices
        hidden
        role="group"
        tabindex="-1"
        aria-labelledby="quiz-question"
        class="grid gap-2.5 focus:outline-none sm:grid-cols-2"
      ></div>

      {/* Feedback on the left, the buttons that move on to the right, so "Not quite" and "Next" read together. */}
      <div class="mt-1 flex min-h-12 flex-wrap items-center justify-end gap-2.5">
        <p data-feedback role="status" class="mr-auto text-body font-semibold"></p>
        <div data-type-nav hidden class="flex gap-2.5">
          <Button data-prev variant="secondary">
            <span aria-hidden="true">←</span> Previous
          </Button>
          <Button data-next variant="secondary">
            Next <span aria-hidden="true">→</span>
          </Button>
        </div>
        <Button data-continue hidden>
          Next question
        </Button>
      </div>
    </section>

    <section data-screen="results" hidden class="flex flex-col items-start gap-3">
      <h2 data-result-title tabindex="-1" class="font-pixel text-label-xl font-bold focus:outline-none">
        Results
      </h2>
      <p data-result-best hidden class={BEST_TAG_CLASS}></p>
      <div data-missed-wrap class="flex w-full flex-col gap-2">
        <h3 class={label}>{quiz.missedHeading}</h3>
        <ul data-missed class="grid gap-2 sm:grid-cols-2"></ul>
      </div>
      <div class="flex flex-wrap gap-2.5">
        <Button data-again icon="play">
          Play again
        </Button>
        <Button data-open-settings variant="secondary" icon="sliders">
          Settings
        </Button>
      </div>
    </section>

    <QuizSettings unit={quiz.unit} modes={quiz.modes} summary={summary} countries={quiz.countries} />
  </div>
</Window>
