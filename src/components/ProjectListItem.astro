---
import type { MoreProject } from '../data/projects';
import Icon from './Icon.astro';

interface Props {
  project: MoreProject;
  /** Alternates the row background, starting with pink. */
  index: number;
}

const { project, index } = Astro.props;
---

<li
  class:list={[
    'flex flex-wrap items-center gap-x-5 gap-y-3 border-b-2 border-ink px-4.5 py-3',
    index % 2 === 0 ? 'bg-blush' : 'bg-paper',
  ]}
>
  <Icon name="file" size="lg" />
  <span class="flex-[1_1_12.5rem] text-body font-semibold">{project.name}</span>
  <span class="flex-[0_1_11.25rem] font-terminal text-label-sm text-ink-soft">{project.tech.join(' · ')}</span>
  <span class="flex-[0_0_3.75rem] font-terminal text-label-sm text-ink-soft">{project.year}</span>
  <a href={project.url} class="font-terminal text-label underline">
    open<span class="sr-only"> {project.name}</span> ▸
  </a>
</li>
