---
import type { HTMLAttributes } from 'astro/types';
import Icon, { type IconName } from './Icon.astro';

interface Props extends Omit<HTMLAttributes<'button'>, 'class'> {
  /** Renders a link. Without it, renders a <button> (type="button" unless set). */
  href?: string;
  /** nav: pixel-font header link. primary: pink. secondary: mint. */
  variant?: 'nav' | 'primary' | 'secondary';
  size?: 'md' | 'lg';
  icon?: IconName;
  /** Marks the nav link for the current page. */
  current?: boolean;
  /** Opens the link in a new tab, and tells screen reader users it will. */
  newTab?: boolean;
  /**
   * Nav only: keep the icon on phones. Nav buttons drop their icons on phones to fit on one row; Home
   * keeps its icon and hides its label instead (see SiteHeader).
   */
  iconOnPhones?: boolean;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  icon,
  current = false,
  newTab = false,
  iconOnPhones = false,
  type = 'button',
  ...attrs
} = Astro.props;

const looks = {
  // On phones, nav buttons are tighter so all three fit on one row.
  nav: [
    'font-terminal text-label-lg tracking-label max-sm:px-3 max-sm:text-label',
    current ? 'bg-mint-light shadow-pink' : 'bg-paper',
  ],
  primary: ['bg-pink-light font-semibold', size === 'lg' ? 'text-body' : 'text-body-sm'],
  secondary: ['bg-mint-pale shadow-pink font-semibold', size === 'lg' ? 'text-body' : 'text-body-sm'],
};
const iconSize = variant !== 'nav' && size === 'md' ? 'sm' : 'md';
const classes = [
  'inline-flex cursor-pointer items-center border-2 border-ink text-ink shadow-hard-3',
  // Hover: mint fill, deeper pink shadow and a small lift. With reduced motion, the colours still change but nothing moves.
  'transition-[background-color,box-shadow,translate] duration-150 hover:-translate-0.5 hover:bg-mint-light hover:shadow-hard-5 hover:shadow-pink',
  'motion-reduce:transition-none motion-reduce:hover:translate-none',
  'focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-violet',
  // Disabled: faded and no hover lift. aria-disabled is for buttons that must keep focus while inactive.
  'disabled:pointer-events-none disabled:opacity-50 aria-disabled:pointer-events-none aria-disabled:opacity-50',
  size === 'lg' ? 'min-h-13 gap-2.5 px-5' : 'min-h-12 gap-2 px-4',
  looks[variant],
];
---

{href ? (
  <a
    href={href}
    aria-current={current ? 'page' : undefined}
    target={newTab ? '_blank' : undefined}
    rel={newTab ? 'noopener noreferrer' : undefined}
    class:list={classes}
  >
    {icon && (
      <span class:list={['inline-flex', variant === 'nav' && !iconOnPhones && 'max-sm:hidden']}>
        <Icon name={icon} size={iconSize} />
      </span>
    )}
    <slot />
    {newTab && <span class="sr-only"> (opens in a new tab)</span>}
  </a>
) : (
  <button type={type} class:list={classes} {...attrs}>
    {icon && <Icon name={icon} size={iconSize} />}
    <slot />
  </button>
)}
