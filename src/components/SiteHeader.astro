---
import Button from './Button.astro';

interface Props {
  current: 'home' | 'quizzes' | 'games';
}

const { current } = Astro.props;
---

<header data-anim="intro" class="flex flex-wrap items-center justify-between gap-4">
  {/* On phones: Home is just its icon (its label stays for screen readers), the others drop their icons. */}
  <nav aria-label="Main" class="flex flex-wrap gap-2.5 max-sm:gap-2">
    <Button href="/" variant="nav" icon="home" current={current === 'home'} iconOnPhones>
      <span class="max-sm:sr-only">Home</span>
    </Button>
    <Button href="/quizzes" variant="nav" icon="puzzle" current={current === 'quizzes'}>
      Quizzes
    </Button>
    <Button href="/games" variant="nav" icon="gamepad" current={current === 'games'}>
      Games
    </Button>
  </nav>
</header>
