---
import Button from './Button.astro';

interface Props {
  current: 'home' | 'projects';
}

const { current } = Astro.props;
---

<header data-anim="intro" class="flex flex-wrap items-center justify-between gap-4">
  <nav aria-label="Main" class="flex flex-wrap gap-2.5">
    <Button href="/" variant="nav" icon="home" current={current === 'home'}>
      Home
    </Button>
    <Button href="/projects.html" variant="nav" icon="folder" current={current === 'projects'}>
      Projects
    </Button>
  </nav>
  <span class="inline-flex items-center gap-2.5 border-2 border-ink bg-paper px-3.5 py-1.5 font-terminal text-label-md tracking-label shadow-hard-4 shadow-pink">
    <span
      data-anim="pulse"
      aria-hidden="true"
      class="size-2.5 rounded-full bg-teal shadow-[0_0_0_4px_rgb(31_184_168/0.2)]"
    ></span>
    Open to senior roles
  </span>
</header>
