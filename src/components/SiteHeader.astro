---
import Button from './Button.astro';

interface Props {
  current: 'home' | 'quizzes';
}

const { current } = Astro.props;
---

<header data-anim="intro" class="flex flex-wrap items-center justify-between gap-4">
  <nav aria-label="Main" class="flex flex-wrap gap-2.5">
    <Button href="/" variant="nav" icon="home" current={current === 'home'}>
      Home
    </Button>
    <Button href="/quizzes" variant="nav" icon="puzzle" current={current === 'quizzes'}>
      Quizzes
    </Button>
  </nav>
</header>
