---
import '../styles/global.css';
import Backdrop from '../components/Backdrop.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description: string;
  /** Highlights the matching nav link. Pages inside a section (like a quiz) use the section's name. */
  page: 'home' | 'quizzes' | 'games';
}

const { title, description, page } = Astro.props;

// Home fills at least one screen and grows (and scrolls) if its content needs more room.
// Other pages scroll over a fixed scene.
const screen = page === 'home';
---

<!doctype html>
<html lang="en-GB" class="scroll-smooth motion-reduce:scroll-auto">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    {/* Hidden until focused: lets keyboard users jump past the header. Every page's <main> has id="main". */}
    <a
      href="#main"
      class="sr-only z-10 border-2 border-ink bg-paper px-4 py-2 font-terminal text-label tracking-label text-ink focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-violet"
    >
      Skip to content
    </a>
    <div class:list={['relative w-full font-sans text-ink', screen ? 'overflow-x-clip bg-page' : 'min-h-screen']}>
      <Backdrop fixed={!screen} />
      <div
        class:list={[
          'relative z-2 flex flex-col px-[clamp(1.25rem,5vw,4.5rem)] py-[clamp(1.25rem,4vw,3rem)]',
          // Content stops spreading at 1440px (padding included) and centres; the scene still fills the screen.
          'mx-auto w-full max-w-360',
          // svh: the visible screen height on phones, excluding the browser toolbar.
          screen ? 'min-h-svh justify-between gap-6 short:py-8' : 'min-h-screen gap-12',
        ]}
      >
        <SiteHeader current={page} />
        <slot />
        <SiteFooter pinBottom={!screen} />
      </div>
    </div>
    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
